{
  "compilerOptions": {
    "target": "es2023",
    "module": "commonjs",
    "moduleDetection": "auto",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "files": [
    "app.ts",
    "app-i18n.ts",
    "app-video.ts",
    "app-effects.ts",
    "app-upscalers.ts",
    "app-dlss5.ts",
    "app-models.ts",
    "app-live.ts",
    "app-hdr-tools.ts",
    "app-preview.ts",
    "app-compare.ts",
    "app-run.ts",
    "app-update.ts",
    "app-done.ts"
  ]
}
