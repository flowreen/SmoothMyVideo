{
  "name": "smoothmyvideo",
  "version": "26.11.4",
  "description": "Desktop GUI for AI video frame interpolation (GMFSS), native CUDA kernels under the hood",
  "author": "Florin Nutiu",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && tsc -p renderer && node --disable-warning=ExperimentalWarning scripts/build-renderer.ts",
    "start": "npm run build && electron .",
    "setup": "node -e \"const fs=require('fs'); fs.rmSync('node_modules', { recursive: true, force: true }); fs.rmSync('package-lock.json', { force: true }); fs.rmSync('engine/bin', { recursive: true, force: true })\" && npm install && node scripts/fetch-ffmpeg.ts && node scripts/stage-gpu-runtime.ts && npm start",
    "dist": "node -e \"require('fs').rmSync('release', { recursive: true, force: true })\" && tsc && tsc -p renderer && node --disable-warning=ExperimentalWarning scripts/build-renderer.ts && node scripts/stage-gpu-runtime.ts --required && electron-builder && node scripts/pack-zip.ts",
    "lint": "prettier --write \"src/**/*.ts\" \"scripts/*.ts\" \"renderer/*.ts\" \"renderer/i18n/*.json\" && tsc --noEmit && tsc -p scripts && tsc -p renderer && node scripts/check-levers.ts && node scripts/clang-format.ts",
    "postinstall": "node scripts/dev-icon.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "prettier": "^3.10.1",
    "rcedit": "^5.0.2",
    "typescript": "^7.0.2"
  },
  "private": true,
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "semi": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "arrowParens": "always"
  },
  "build": {
    "appId": "com.smoothmyvideo.app",
    "productName": "SmoothMyVideo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "!renderer/*.ts",
      "!renderer/tsconfig.json",
      "assets/icon.ico",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*",
          "!runtime/**",
          "!**/*.pkl",
          "!**/*.pth",
          "realesrgan/realesr-animevideov3.pkl",
          "GMFSS_Fortuna/train_log/feat.pkl",
          "GMFSS_Fortuna/train_log/metric.pkl",
          "GMFSS_Fortuna/train_log/rife.pkl",
          "GMFSS_Fortuna/train_log/fusionnet.pkl",
          "GMFSS_Fortuna/train_log/flownet.pkl",
          "rife/flownet.pkl",
          "artcnn/artcnn_c4f32_dn_v1.6.2_fp16.pkl",
          "!runtime_*_bak/**",
          "!rtxvideo/nvngx_vsr.dll",
          "!rtxvideo/nvngx_truehdr.dll",
          "!dlssnr/nvngx_dlssnr.dll",
          "!dlssnr/nvngx_dlss.dll",
          "!animejanai/**",
          "!restore/**",
          "!**/build_src/**",
          "!**/*.log",
          "!nvvfx/NVVideoEffects.dll",
          "!nvvfx/NVCVImage.dll",
          "!nvvfx/nvVFXVideoFrameGeneration.dll",
          "!nvvfx/cudart64_12.dll",
          "!nvoffruc/NvOFFRUC.dll",
          "!nvoffruc/cudart64_110.dll",
          "!dvtools/**",
          "!hptools/**",
          "!xess/libxess.dll",
          "!xess/libxess_fg.dll",
          "!xess/libxell.dll",
          "!xess/XeSS_LICENSE.txt",
          "!.clang-format"
        ]
      }
    ],
    "extraFiles": [
      "LICENSE",
      {
        "from": "docs/THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico"
    }
  }
}
