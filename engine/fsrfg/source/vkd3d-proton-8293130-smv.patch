+/* SMV patch: AMD FSR 4 frame generation records about half of its compute dispatches with no D3D12 barrier, copy or
+ * clear since the dispatch before them; on NVIDIA such a dispatch overlaps its predecessor and an occasional call
+ * computes differently run to run (which dispatches, depends on the size). A compute barrier before every dispatch
+ * that follows such a gap makes every run byte-identical, for about 3 % of a 4K x8 pair. SMV_VKD3D_FG_BARRIER=0 turns
+ * the barriers off, =all puts one before every compute dispatch. */
+static bool smv_fg_barrier_before_dispatch(struct d3d12_command_list *list)
+{
+    static int mode = -1; /* 1 = the dispatches after a gap with no sync, 2 = every compute dispatch, 0 = off */
+
+    if (mode < 0)
+    {
+        char env[8];
+
+        mode = 1;
+        if (vkd3d_get_env_var("SMV_VKD3D_FG_BARRIER", env, sizeof(env)))
+            mode = env[0] == '0' ? 0 : (!strcmp(env, "all") ? 2 : 1);
+    }
+    if (mode == 2)
+        return true;
+    return mode == 1 && !list->smv_sync_seen;
+}
