+// wmma_fp8_staging: FP8 matrices are emulated as FP16, and their memory form (bytes) never becomes an 8-bit
+// cooperative matrix (out of spec where the implementation exposes no 16x16x16 8-bit shape, e.g. NVIDIA). A load reads
+// the 256 bytes element-wise, converts them to FP16 into this subgroup's LDS scratch block (column-major, stride 8
+// u32 = 16 FP16 per column), then loads the FP16 matrix from there; a store is the reverse. Each lane handles element
+// pairs p = (lane + i * min_wave) & 127: column p >> 3, rows 2 * (p & 7) and + 1, scratch word p.
+static spv::Id emit_staging_u32_op(Converter::Impl &impl, spv::Op op, spv::Id a, spv::Id b)
+{
+	auto *o = impl.allocate(op, impl.builder().makeUintType(32));
+	o->add_id(a);
+	o->add_id(b);
+	impl.add(o);
+	return o->id;
+}
+
+static void emit_staging_barrier(Converter::Impl &impl)
+{
+	auto &builder = impl.builder();
+	auto *barrier = impl.allocate(spv::OpControlBarrier);
+	barrier->add_id(builder.makeUintConstant(spv::ScopeSubgroup));
+	barrier->add_id(builder.makeUintConstant(spv::ScopeSubgroup));
+	barrier->add_id(builder.getWorkgroupBarrierSemanticsId());
+	impl.add(barrier);
+}
+
+static spv::Id emit_staging_scratch_ptr(Converter::Impl &impl, spv::Id word_index)
+{
+	auto &builder = impl.builder();
+	auto *chain = impl.allocate(spv::OpInBoundsAccessChain,
+	                            builder.makePointer(spv::StorageClassWorkgroup, builder.makeUintType(32)));
+	chain->add_id(impl.ags.coopmat_transpose_scratch);
+	chain->add_id(word_index);
+	impl.add(chain);
+	return chain->id;
+}
+
+static spv::Id emit_staging_scratch_base(Converter::Impl &impl)
+{
+	auto &builder = impl.builder();
+	spv::Id subgroup_id_var = impl.spirv_module.get_builtin_shader_input(spv::BuiltInSubgroupId);
+	auto *subgroup_id = impl.allocate(spv::OpLoad, builder.makeUintType(32));
+	subgroup_id->add_id(subgroup_id_var);
+	impl.add(subgroup_id);
+	return emit_staging_u32_op(impl, spv::OpIMul, subgroup_id->id, builder.makeUintConstant(16 * 16));
+}
+
+static uint32_t staging_min_wave(Converter::Impl &impl)
+{
+	uint32_t w = impl.execution_mode_meta.wave_size_min;
+	if (!w)
+		w = impl.options.subgroup_size.implementation_minimum;
+	if (!w || w > 128)
+		w = 32;
+	return w;
+}
+
+// Byte offset of matrix element (row, col) from the access chain's offset, in bytes (LDS: stride is in u32 units).
+static spv::Id emit_staging_byte_offset(Converter::Impl &impl, const WMMAAccessChain &chain, bool column_major,
+                                        spv::Id row, spv::Id col)
+{
+	auto &builder = impl.builder();
+	spv::Id major = column_major ? col : row;
+	spv::Id minor = column_major ? row : col;
+	spv::Id stride = chain.stride_id;
+	if (chain.kind == WMMAMemoryKind::LDS)
+		stride = emit_staging_u32_op(impl, spv::OpIMul, stride, builder.makeUintConstant(4));
+	spv::Id m = emit_staging_u32_op(impl, spv::OpIMul, major, stride);
+	return emit_staging_u32_op(impl, spv::OpIAdd, m, minor);
+}
+
+static spv::Id emit_staging_byte_ptr(Converter::Impl &impl, const WMMAAccessChain &chain, spv::Id byte_off)
+{
+	auto &builder = impl.builder();
+	spv::Id u8_type = builder.makeUintType(8);
+	if (chain.kind == WMMAMemoryKind::SSBO)
+	{
+		spv::Id idx = emit_staging_u32_op(impl, spv::OpIAdd, chain.offset_id, byte_off);
+		auto *ptr = impl.allocate(spv::OpAccessChain, builder.makePointer(spv::StorageClassStorageBuffer, u8_type));
+		ptr->add_id(chain.base_id);
+		ptr->add_id(builder.makeUintConstant(0));
+		ptr->add_id(idx);
+		impl.add(ptr);
+		return ptr->id;
+	}
+	else
+	{
+		spv::Id idx = emit_staging_u32_op(impl, spv::OpIAdd, chain.offset_id, byte_off);
+		auto *ptr = impl.allocate(spv::OpAccessChain,
+		                          builder.makePointer(spv::StorageClassPhysicalStorageBuffer, u8_type));
+		ptr->add_id(chain.base_id);
+		ptr->add_id(idx);
+		impl.add(ptr);
+		return ptr->id;
+	}
+}
+
+static spv::Id emit_staging_lds_word_ptr(Converter::Impl &impl, const WMMAAccessChain &chain, spv::Id byte_off)
+{
+	auto &builder = impl.builder();
+	spv::Id word = emit_staging_u32_op(impl, spv::OpShiftRightLogical, byte_off, builder.makeUintConstant(2));
+	word = emit_staging_u32_op(impl, spv::OpIAdd, chain.offset_id, word);
+	auto *ptr = impl.allocate(spv::OpAccessChain,
+	                          builder.makePointer(spv::StorageClassWorkgroup, builder.makeUintType(32)));
+	ptr->add_id(chain.base_id);
+	ptr->add_id(word);
+	impl.add(ptr);
+	return ptr->id;
+}
+
+static spv::Id emit_staging_lds_shift(Converter::Impl &impl, spv::Id byte_off)
+{
+	auto &builder = impl.builder();
+	spv::Id lane = emit_staging_u32_op(impl, spv::OpBitwiseAnd, byte_off, builder.makeUintConstant(3));
+	return emit_staging_u32_op(impl, spv::OpShiftLeftLogical, lane, builder.makeUintConstant(3));
+}
+
+static spv::Id emit_staging_load_fp8_as_fp16(Converter::Impl &impl, const WMMAAccessChain &chain, spv::Id byte_off)
+{
+	auto &builder = impl.builder();
+	spv::Id u8_type = builder.makeUintType(8);
+	spv::Id f16_type = builder.makeFloatType(16);
+	spv::Id u8_val;
+
+	if (chain.kind == WMMAMemoryKind::LDS)
+	{
+		auto *load = impl.allocate(spv::OpLoad, builder.makeUintType(32));
+		load->add_id(emit_staging_lds_word_ptr(impl, chain, byte_off));
+		impl.add(load);
+		spv::Id v = emit_staging_u32_op(impl, spv::OpShiftRightLogical, load->id, emit_staging_lds_shift(impl, byte_off));
+		auto *narrow = impl.allocate(spv::OpUConvert, u8_type);
+		narrow->add_id(v);
+		impl.add(narrow);
+		u8_val = narrow->id;
+	}
+	else
+	{
+		auto *load = impl.allocate(spv::OpLoad, u8_type);
+		load->add_id(emit_staging_byte_ptr(impl, chain, byte_off));
+		if (chain.kind == WMMAMemoryKind::BDA)
+		{
+			load->add_literal(spv::MemoryAccessAlignedMask);
+			load->add_literal(1);
+		}
+		impl.add(load);
+		u8_val = load->id;
+	}
+
+	spv::Id type_ids[] = { u8_type, f16_type };
+	spv::Id helper_id = impl.spirv_module.get_helper_call_id(HelperCall::ScalarFP8toFP16, type_ids, 2);
+	auto *conv = impl.allocate(spv::OpFunctionCall, f16_type);
+	conv->add_id(helper_id);
+	conv->add_id(u8_val);
+	impl.add(conv);
+	return conv->id;
+}
+
+static void emit_staging_store_fp16_as_fp8(Converter::Impl &impl, const WMMAAccessChain &chain, spv::Id byte_off,
+                                           spv::Id f16_val)
+{
+	auto &builder = impl.builder();
+	spv::Id u8_type = builder.makeUintType(8);
+	spv::Id f16_type = builder.makeFloatType(16);
+
+	spv::Id type_ids[] = { u8_type, f16_type };
+	spv::Id helper_id = impl.spirv_module.get_helper_call_id(HelperCall::ScalarFP16toFP8, type_ids, 2);
+	auto *conv = impl.allocate(spv::OpFunctionCall, u8_type);
+	conv->add_id(helper_id);
+	conv->add_id(f16_val);
+	impl.add(conv);
+
+	if (chain.kind == WMMAMemoryKind::LDS)
+	{
+		// Other lanes write the other bytes of the same word: clear + set atomically.
+		spv::Id ptr = emit_staging_lds_word_ptr(impl, chain, byte_off);
+		spv::Id shift = emit_staging_lds_shift(impl, byte_off);
+		spv::Id mask = emit_staging_u32_op(impl, spv::OpShiftLeftLogical, builder.makeUintConstant(0xff), shift);
+		auto *inv = impl.allocate(spv::OpNot, builder.makeUintType(32));
+		inv->add_id(mask);
+		impl.add(inv);
+		auto *wide = impl.allocate(spv::OpUConvert, builder.makeUintType(32));
+		wide->add_id(conv->id);
+		impl.add(wide);
+		spv::Id bits = emit_staging_u32_op(impl, spv::OpShiftLeftLogical, wide->id, shift);
+
+		auto *and_op = impl.allocate(spv::OpAtomicAnd, builder.makeUintType(32));
+		and_op->add_id(ptr);
+		and_op->add_id(builder.makeUintConstant(spv::ScopeWorkgroup));
+		and_op->add_id(builder.makeUintConstant(0));
+		and_op->add_id(inv->id);
+		impl.add(and_op);
+		auto *or_op = impl.allocate(spv::OpAtomicOr, builder.makeUintType(32));
+		or_op->add_id(ptr);
+		or_op->add_id(builder.makeUintConstant(spv::ScopeWorkgroup));
+		or_op->add_id(builder.makeUintConstant(0));
+		or_op->add_id(bits);
+		impl.add(or_op);
+	}
+	else
+	{
+		auto *store = impl.allocate(spv::OpStore);
+		store->add_id(emit_staging_byte_ptr(impl, chain, byte_off));
+		store->add_id(conv->id);
+		if (chain.kind == WMMAMemoryKind::BDA)
+		{
+			store->add_literal(spv::MemoryAccessAlignedMask);
+			store->add_literal(1);
+		}
+		impl.add(store);
+	}
+}
+
+// Rows / column of element pair p: col = p >> 3, row0 = 2 * (p & 7), row1 = row0 + 1.
+static void emit_staging_pair_coords(Converter::Impl &impl, spv::Id p, spv::Id &col, spv::Id &row0, spv::Id &row1)
+{
+	auto &builder = impl.builder();
+	col = emit_staging_u32_op(impl, spv::OpShiftRightLogical, p, builder.makeUintConstant(3));
+	spv::Id r = emit_staging_u32_op(impl, spv::OpBitwiseAnd, p, builder.makeUintConstant(7));
+	row0 = emit_staging_u32_op(impl, spv::OpShiftLeftLogical, r, builder.makeUintConstant(1));
+	row1 = emit_staging_u32_op(impl, spv::OpIAdd, row0, builder.makeUintConstant(1));
+}
+
+static spv::Id emit_staging_pair_index(Converter::Impl &impl, spv::Id lane, uint32_t i, uint32_t wave)
+{
+	auto &builder = impl.builder();
+	spv::Id p = emit_staging_u32_op(impl, spv::OpIAdd, lane, builder.makeUintConstant(i * wave));
+	return emit_staging_u32_op(impl, spv::OpBitwiseAnd, p, builder.makeUintConstant(127));
+}
+
+static spv::Id emit_staging_lane(Converter::Impl &impl)
+{
+	auto &builder = impl.builder();
+	spv::Id var = impl.spirv_module.get_builtin_shader_input(spv::BuiltInSubgroupLocalInvocationId);
+	auto *lane = impl.allocate(spv::OpLoad, builder.makeUintType(32));
+	lane->add_id(var);
+	impl.add(lane);
+	return lane->id;
+}
+
+static void staging_add_capabilities(Converter::Impl &impl, const WMMAAccessChain &chain)
+{
+	auto &builder = impl.builder();
+	builder.addCapability(spv::CapabilityInt8);
+	builder.addCapability(spv::CapabilityFloat16);
+	if (chain.kind != WMMAMemoryKind::LDS)
+	{
+		builder.addExtension("SPV_KHR_8bit_storage");
+		builder.addCapability(spv::CapabilityStorageBuffer8BitAccess);
+	}
+}
+
+static spv::Id emit_staging_word_load(Converter::Impl &impl, spv::StorageClass storage, spv::Id base, bool member0,
+                                      spv::Id index)
+{
+	auto &builder = impl.builder();
+	auto *ptr = impl.allocate(spv::OpAccessChain, builder.makePointer(storage, builder.makeUintType(32)));
+	ptr->add_id(base);
+	if (member0)
+		ptr->add_id(builder.makeUintConstant(0));
+	ptr->add_id(index);
+	impl.add(ptr);
+	auto *load = impl.allocate(spv::OpLoad, builder.makeUintType(32));
+	load->add_id(ptr->id);
+	impl.add(load);
+	return load->id;
+}
+
+static spv::Id emit_staging_select(Converter::Impl &impl, spv::Id cond, spv::Id a, spv::Id b)
+{
+	auto *sel = impl.allocate(spv::OpSelect, impl.builder().makeUintType(32));
+	sel->add_id(cond);
+	sel->add_id(a);
+	sel->add_id(b);
+	impl.add(sel);
+	return sel->id;
+}
+
+// The coalesced staged load (32-lane subgroups, SSBO or LDS sources): lane L reads the 8-byte run of line L >> 1
+// (a row of a row-major source, a column of a column-major one), bytes 8 (L & 1) .. + 7, as u32 words (an SSBO run
+// at any byte alignment = three words funnel-shifted; an LDS run starts on a word), converts the bytes with the same
+// ScalarFP8toFP16, and writes four f16-pair words to the scratch block in the source's own layout (stride 8 words =
+// 16 FP16 a line), so the coopmat load takes that layout: the matrix holds the byte path's values, from one
+// coalesced read a lane instead of eight byte gathers. Returns 0 where it does not apply (no u32 view of the buffer,
+// BDA, another subgroup size): the byte path below then runs.
+static spv::Id emit_fp8_staged_load_vec(Converter::Impl &impl, const WMMAAccessChain &chain, bool column_major,
+                                        uint32_t type_imm)
+{
+	auto &builder = impl.builder();
+	if (staging_min_wave(impl) != 32 || chain.kind == WMMAMemoryKind::BDA || chain.kind == WMMAMemoryKind::None)
+		return 0;
+
+	spv::Id u32_view = 0;
+	if (chain.kind == WMMAMemoryKind::SSBO)
+	{
+		const auto &meta = impl.handle_to_resource_meta[impl.ags.active_uav_ptr];
+		for (auto &alias : meta.var_alias_group)
+			if (alias.declaration.type == RawType::Integer && alias.declaration.width == RawWidth::B32 &&
+			    alias.declaration.vecsize == 1)
+				u32_view = alias.var_id;
+		if (!u32_view)
+			return 0;
+	}
+
+	if (!ensure_coopmat_scratch(impl))
+		return 0;
+	spv::Id f16_mat = build_coopmat_type(impl, type_imm, false);
+	if (!f16_mat)
+		return 0;
+	staging_add_capabilities(impl, chain);
+
+	spv::Id u8_type = builder.makeUintType(8);
+	spv::Id f16_type = builder.makeFloatType(16);
+	spv::Id f16vec2 = builder.makeVectorType(f16_type, 2);
+	spv::Id base = emit_staging_scratch_base(impl);
+	spv::Id lane = emit_staging_lane(impl);
+	spv::Id line = emit_staging_u32_op(impl, spv::OpShiftRightLogical, lane, builder.makeUintConstant(1));
+	spv::Id half = emit_staging_u32_op(impl, spv::OpBitwiseAnd, lane, builder.makeUintConstant(1));
+
+	// Previous users of the scratch block (and of an LDS source) are done; an SSBO source's words are read before
+	// this barrier, which guards only the scratch.
+	if (chain.kind == WMMAMemoryKind::LDS)
+		emit_staging_barrier(impl);
+
+	spv::Id lo, hi;
+	if (chain.kind == WMMAMemoryKind::LDS)
+	{
+		spv::Id w = emit_staging_u32_op(impl, spv::OpIMul, line, chain.stride_id);
+		w = emit_staging_u32_op(impl, spv::OpIAdd, w, chain.offset_id);
+		w = emit_staging_u32_op(impl, spv::OpIAdd, w,
+		                        emit_staging_u32_op(impl, spv::OpShiftLeftLogical, half, builder.makeUintConstant(1)));
+		lo = emit_staging_word_load(impl, spv::StorageClassWorkgroup, chain.base_id, false, w);
+		hi = emit_staging_word_load(impl, spv::StorageClassWorkgroup, chain.base_id, false,
+		                            emit_staging_u32_op(impl, spv::OpIAdd, w, builder.makeUintConstant(1)));
+	}
+	else
+	{
+		spv::Id b = emit_staging_u32_op(impl, spv::OpIMul, line, chain.stride_id);
+		b = emit_staging_u32_op(impl, spv::OpIAdd, b, chain.offset_id);
+		b = emit_staging_u32_op(impl, spv::OpIAdd, b,
+		                        emit_staging_u32_op(impl, spv::OpShiftLeftLogical, half, builder.makeUintConstant(3)));
+		spv::Id w = emit_staging_u32_op(impl, spv::OpShiftRightLogical, b, builder.makeUintConstant(2));
+		spv::Id s = emit_staging_u32_op(impl, spv::OpShiftLeftLogical,
+		                                emit_staging_u32_op(impl, spv::OpBitwiseAnd, b, builder.makeUintConstant(3)),
+		                                builder.makeUintConstant(3));
+		auto *unaligned = impl.allocate(spv::OpINotEqual, builder.makeBoolType());
+		unaligned->add_id(s);
+		unaligned->add_id(builder.makeUintConstant(0));
+		impl.add(unaligned);
+		spv::Id w1 = emit_staging_u32_op(impl, spv::OpIAdd, w, builder.makeUintConstant(1));
+		// An aligned run reads word w + 1 again instead of the word past its last byte.
+		spv::Id w2 = emit_staging_u32_op(impl, spv::OpIAdd, w1,
+		                                 emit_staging_select(impl, unaligned->id, builder.makeUintConstant(1),
+		                                                     builder.makeUintConstant(0)));
+		spv::Id v0 = emit_staging_word_load(impl, spv::StorageClassStorageBuffer, u32_view, true, w);
+		spv::Id v1 = emit_staging_word_load(impl, spv::StorageClassStorageBuffer, u32_view, true, w1);
+		spv::Id v2 = emit_staging_word_load(impl, spv::StorageClassStorageBuffer, u32_view, true, w2);
+		spv::Id inv = emit_staging_u32_op(impl, spv::OpISub, builder.makeUintConstant(32), s);
+		// s = 0 shifts by 32 only on the side of the select that is discarded.
+		spv::Id f0 = emit_staging_u32_op(impl, spv::OpBitwiseOr, emit_staging_u32_op(impl, spv::OpShiftRightLogical, v0, s),
+		                                 emit_staging_u32_op(impl, spv::OpShiftLeftLogical, v1, inv));
+		spv::Id f1 = emit_staging_u32_op(impl, spv::OpBitwiseOr, emit_staging_u32_op(impl, spv::OpShiftRightLogical, v1, s),
+		                                 emit_staging_u32_op(impl, spv::OpShiftLeftLogical, v2, inv));
+		lo = emit_staging_select(impl, unaligned->id, f0, v0);
+		hi = emit_staging_select(impl, unaligned->id, f1, v1);
+		emit_staging_barrier(impl);
+	}
+
+	spv::Id type_ids[] = { u8_type, f16_type };
+	spv::Id helper_id = impl.spirv_module.get_helper_call_id(HelperCall::ScalarFP8toFP16, type_ids, 2);
+	spv::Id dst = emit_staging_u32_op(impl, spv::OpShiftLeftLogical, line, builder.makeUintConstant(3));
+	dst = emit_staging_u32_op(impl, spv::OpIAdd, dst,
+	                          emit_staging_u32_op(impl, spv::OpShiftLeftLogical, half, builder.makeUintConstant(2)));
+	dst = emit_staging_u32_op(impl, spv::OpIAdd, dst, base);
+	for (uint32_t j = 0; j < 4; j++)
+	{
+		spv::Id src = j < 2 ? lo : hi;
+		spv::Id v[2];
+		for (uint32_t k = 0; k < 2; k++)
+		{
+			uint32_t shift = (j & 1) * 16 + k * 8;
+			spv::Id bits = shift ? emit_staging_u32_op(impl, spv::OpShiftRightLogical, src, builder.makeUintConstant(shift))
+			                     : src;
+			auto *narrow = impl.allocate(spv::OpUConvert, u8_type);
+			narrow->add_id(bits);
+			impl.add(narrow);
+			auto *conv = impl.allocate(spv::OpFunctionCall, f16_type);
+			conv->add_id(helper_id);
+			conv->add_id(narrow->id);
+			impl.add(conv);
+			v[k] = conv->id;
+		}
+		auto *pair = impl.allocate(spv::OpCompositeConstruct, f16vec2);
+		pair->add_id(v[0]);
+		pair->add_id(v[1]);
+		impl.add(pair);
+		auto *word = impl.allocate(spv::OpBitcast, builder.makeUintType(32));
+		word->add_id(pair->id);
+		impl.add(word);
+		auto *store = impl.allocate(spv::OpStore);
+		store->add_id(emit_staging_scratch_ptr(impl, j ? emit_staging_u32_op(impl, spv::OpIAdd, dst,
+		                                                                     builder.makeUintConstant(j))
+		                                                : dst));
+		store->add_id(word->id);
+		impl.add(store);
+	}
+	emit_staging_barrier(impl);
+
+	auto *load = impl.allocate(spv::OpCooperativeMatrixLoadKHR, f16_mat);
+	load->add_id(emit_staging_scratch_ptr(impl, base));
+	load->add_id(builder.makeUintConstant(column_major ? spv::CooperativeMatrixLayoutColumnMajorKHR :
+	                                                     spv::CooperativeMatrixLayoutRowMajorKHR));
+	load->add_id(builder.makeUintConstant(8));
+	if (impl.execution_mode_meta.memory_model == spv::MemoryModelVulkan)
+		load->add_literal(spv::MemoryAccessNonPrivatePointerMask);
+	impl.add(load);
+	// No trailing barrier: every writer of the scratch block starts with one (the staged loads and stores, the
+	// transpose path).
+	return load->id;
+}
+
+// The decode function of the FP8 tensor load: its block is one byte (block size 1 x 1), so the pointer the
+// implementation passes is the element's own byte; it returns ScalarFP8toFP16 of it (the staged paths' conversion).
+static spv::Id get_fp8_decode_tensor_func(Converter::Impl &impl)
+{
+	if (impl.ags.fp8_decode_tensor_func)
+		return impl.ags.fp8_decode_tensor_func;
+	auto &builder = impl.builder();
+	spv::Id u8_type = builder.makeUintType(8);
+	spv::Id u32_type = builder.makeUintType(32);
+	spv::Id f16_type = builder.makeFloatType(16);
+	spv::Id type_ids[] = { u8_type, f16_type };
+	spv::Id conv_id = impl.spirv_module.get_helper_call_id(HelperCall::ScalarFP8toFP16, type_ids, 2);
+
+	spv::Id block_type = builder.makeStructType({ u8_type }, "FP8DecodeBlock");
+	builder.addDecoration(block_type, spv::DecorationBlock);
+	builder.addMemberDecoration(block_type, 0, spv::DecorationOffset, 0);
+	spv::Id block_ptr = builder.makePointer(spv::StorageClassPhysicalStorageBuffer, block_type);
+	spv::Id coords = builder.makeArrayType(u32_type, builder.makeUintConstant(2), 0);
+
+	auto *current = builder.getBuildPoint();
+	spv::Block *entry = nullptr;
+	auto *func = builder.makeFunctionEntry(spv::NoPrecision, f16_type, "FP8DecodeTensor", { block_ptr, coords, coords },
+	                                       {}, &entry);
+	builder.addDecoration(func->getParamId(0), spv::DecorationRestrictPointer);
+	builder.setBuildPoint(entry);
+	auto *chain = builder.addInstruction(builder.makePointer(spv::StorageClassPhysicalStorageBuffer, u8_type),
+	                                     spv::OpAccessChain);
+	chain->addIdOperand(func->getParamId(0));
+	chain->addIdOperand(builder.makeUintConstant(0));
+	auto *load = builder.addInstruction(u8_type, spv::OpLoad);
+	load->addIdOperand(chain->getResultId());
+	load->addImmediateOperand(spv::MemoryAccessAlignedMask);
+	load->addImmediateOperand(1);
+	auto *call = builder.addInstruction(f16_type, spv::OpFunctionCall);
+	call->addIdOperand(conv_id);
+	call->addIdOperand(load->getResultId());
+	builder.makeReturn(false, call->getResultId());
+	builder.setBuildPoint(current);
+	impl.ags.fp8_decode_tensor_func = func->getId();
+	return func->getId();
+}
+
+// An SSBO FP8 tile as one tensor load (VK_NV_cooperative_matrix2 tensor addressing + block loads): a 2D layout over
+// the u8 buffer from its first byte (the 16-byte aligned pointer the load requires), the tile's stride on its major
+// dimension and 1 on the minor, a 16 x 16 slice at the tile's offset, the decode function per element. No scratch
+// block and no barriers, so the compiler can overlap tiles' loads: the staged paths wait each tile's misses out at
+// their barriers. The matrix holds the staged paths' values. Returns 0 where it does not apply (LDS / BDA sources).
+static spv::Id emit_fp8_staged_load_tensor(Converter::Impl &impl, const WMMAAccessChain &chain, bool column_major,
+                                           uint32_t type_imm)
+{
+	auto &builder = impl.builder();
+	if (!impl.options.nv_cooperative_matrix2_tensor_loads || chain.kind != WMMAMemoryKind::SSBO)
+		return 0;
+	spv::Id f16_mat = build_coopmat_type(impl, type_imm, false);
+	if (!f16_mat)
+		return 0;
+	staging_add_capabilities(impl, chain);
+	builder.addCapability(spv::CapabilityCooperativeMatrixBlockLoadsNV);
+	// The decode function's block pointer is a PhysicalStorageBuffer one (vkd3d's modules are PSB64 already).
+	builder.addCapability(spv::CapabilityPhysicalStorageBufferAddresses);
+	builder.addExtension("SPV_KHR_physical_storage_buffer");
+	builder.setMemoryModel(spv::AddressingModelPhysicalStorageBuffer64, impl.execution_mode_meta.memory_model);
+	if (!impl.ags.tensor_layout_type)
+		impl.ags.tensor_layout_type =
+		    builder.makeTensorLayoutTypeNV(builder.makeUintConstant(2), builder.makeUintConstant(0));
+	spv::Id lt = impl.ags.tensor_layout_type;
+	spv::Id decode = get_fp8_decode_tensor_func(impl);
+	spv::Id zero = builder.makeUintConstant(0);
+	spv::Id one = builder.makeUintConstant(1);
+	spv::Id span = builder.makeUintConstant(16);
+	spv::Id big = builder.makeUintConstant(0x40000000);
+
+	auto *l0 = impl.allocate(spv::OpCreateTensorLayoutNV, lt);
+	impl.add(l0);
+	auto *l1 = impl.allocate(spv::OpTensorLayoutSetDimensionNV, lt);
+	l1->add_id(l0->id);
+	l1->add_id(big);
+	l1->add_id(big);
+	impl.add(l1);
+	auto *l2 = impl.allocate(spv::OpTensorLayoutSetStrideNV, lt);
+	l2->add_id(l1->id);
+	l2->add_id(column_major ? one : chain.stride_id);
+	l2->add_id(column_major ? chain.stride_id : one);
+	impl.add(l2);
+	auto *l3 = impl.allocate(spv::OpTensorLayoutSliceNV, lt);
+	l3->add_id(l2->id);
+	l3->add_id(column_major ? chain.offset_id : zero);
+	l3->add_id(span);
+	l3->add_id(column_major ? zero : chain.offset_id);
+	l3->add_id(span);
+	impl.add(l3);
+
+	auto *ptr = impl.allocate(spv::OpAccessChain, builder.makePointer(spv::StorageClassStorageBuffer, builder.makeUintType(8)));
+	ptr->add_id(chain.base_id);
+	ptr->add_id(zero);
+	ptr->add_id(zero);
+	impl.add(ptr);
+
+	auto *load = impl.allocate(spv::OpCooperativeMatrixLoadTensorNV, f16_mat);
+	load->add_id(ptr->id);
+	load->add_id(builder.makeNullConstant(f16_mat));
+	load->add_id(l3->id);
+	load->add_literal(impl.execution_mode_meta.memory_model == spv::MemoryModelVulkan ?
+	                      uint32_t(spv::MemoryAccessNonPrivatePointerMask) : 0u);
+	load->add_literal(spv::TensorAddressingOperandsDecodeFuncMask);
+	load->add_id(decode);
+	impl.add(load);
+	return load->id;
+}
+
+static spv::Id emit_fp8_staged_load(Converter::Impl &impl, const WMMAAccessChain &chain, bool column_major,
+                                    uint32_t type_imm)
+{
+	auto &builder = impl.builder();
+	if (spv::Id tensor_id = emit_fp8_staged_load_tensor(impl, chain, column_major, type_imm))
+		return tensor_id;
+	if (spv::Id vec_id = emit_fp8_staged_load_vec(impl, chain, column_major, type_imm))
+		return vec_id;
+	if (!ensure_coopmat_scratch(impl))
+		return 0;
+	spv::Id f16_mat = build_coopmat_type(impl, type_imm, false);
+	if (!f16_mat)
+		return 0;
+	staging_add_capabilities(impl, chain);
+
+	spv::Id base = emit_staging_scratch_base(impl);
+	spv::Id lane = emit_staging_lane(impl);
+	uint32_t wave = staging_min_wave(impl);
+	spv::Id f16vec2 = builder.makeVectorType(builder.makeFloatType(16), 2);
+
+	// Previous users of the scratch block (and of an LDS source) are done.
+	emit_staging_barrier(impl);
+	for (uint32_t i = 0; i < 128 / wave || i == 0; i++)
+	{
+		spv::Id p = emit_staging_pair_index(impl, lane, i, wave);
+		spv::Id col, row0, row1;
+		emit_staging_pair_coords(impl, p, col, row0, row1);
+		spv::Id v0 = emit_staging_load_fp8_as_fp16(impl, chain, emit_staging_byte_offset(impl, chain, column_major, row0, col));
+		spv::Id v1 = emit_staging_load_fp8_as_fp16(impl, chain, emit_staging_byte_offset(impl, chain, column_major, row1, col));
+		auto *pair = impl.allocate(spv::OpCompositeConstruct, f16vec2);
+		pair->add_id(v0);
+		pair->add_id(v1);
+		impl.add(pair);
+		auto *word = impl.allocate(spv::OpBitcast, builder.makeUintType(32));
+		word->add_id(pair->id);
+		impl.add(word);
+		auto *store = impl.allocate(spv::OpStore);
+		store->add_id(emit_staging_scratch_ptr(impl, emit_staging_u32_op(impl, spv::OpIAdd, base, p)));
+		store->add_id(word->id);
+		impl.add(store);
+	}
+	emit_staging_barrier(impl);
+
+	auto *load = impl.allocate(spv::OpCooperativeMatrixLoadKHR, f16_mat);
+	load->add_id(emit_staging_scratch_ptr(impl, base));
+	load->add_id(builder.makeUintConstant(spv::CooperativeMatrixLayoutColumnMajorKHR));
+	load->add_id(builder.makeUintConstant(8));
+	if (impl.execution_mode_meta.memory_model == spv::MemoryModelVulkan)
+		load->add_literal(spv::MemoryAccessNonPrivatePointerMask);
+	impl.add(load);
+	emit_staging_barrier(impl);
+	return load->id;
+}
+
+static bool emit_fp8_staged_store(Converter::Impl &impl, const WMMAAccessChain &chain, bool column_major,
+                                  spv::Id f16_matrix)
+{
+	auto &builder = impl.builder();
+	if (!ensure_coopmat_scratch(impl))
+		return false;
+	staging_add_capabilities(impl, chain);
+
+	spv::Id base = emit_staging_scratch_base(impl);
+	spv::Id lane = emit_staging_lane(impl);
+	uint32_t wave = staging_min_wave(impl);
+	spv::Id f16_type = builder.makeFloatType(16);
+	spv::Id f16vec2 = builder.makeVectorType(f16_type, 2);
+
+	emit_staging_barrier(impl);
+	auto *store = impl.allocate(spv::OpCooperativeMatrixStoreKHR);
+	store->add_id(emit_staging_scratch_ptr(impl, base));
+	store->add_id(f16_matrix);
+	store->add_id(builder.makeUintConstant(spv::CooperativeMatrixLayoutColumnMajorKHR));
+	store->add_id(builder.makeUintConstant(8));
+	if (impl.execution_mode_meta.memory_model == spv::MemoryModelVulkan)
+		store->add_literal(spv::MemoryAccessNonPrivatePointerMask);
+	impl.add(store);
+	emit_staging_barrier(impl);
+
+	for (uint32_t i = 0; i < 128 / wave || i == 0; i++)
+	{
+		spv::Id p = emit_staging_pair_index(impl, lane, i, wave);
+		spv::Id col, row0, row1;
+		emit_staging_pair_coords(impl, p, col, row0, row1);
+		auto *word = impl.allocate(spv::OpLoad, builder.makeUintType(32));
+		word->add_id(emit_staging_scratch_ptr(impl, emit_staging_u32_op(impl, spv::OpIAdd, base, p)));
+		impl.add(word);
+		auto *pair = impl.allocate(spv::OpBitcast, f16vec2);
+		pair->add_id(word->id);
+		impl.add(pair);
+		for (uint32_t k = 0; k < 2; k++)
+		{
+			auto *e = impl.allocate(spv::OpCompositeExtract, f16_type);
+			e->add_id(pair->id);
+			e->add_literal(k);
+			impl.add(e);
+			emit_staging_store_fp16_as_fp8(
+			    impl, chain, emit_staging_byte_offset(impl, chain, column_major, k ? row1 : row0, col), e->id);
+		}
+	}
+	// The destination (LDS in particular) is read by other lanes next.
+	emit_staging_barrier(impl);
+	return true;
+}
