// clang-format on

// Anime4K's conv passes as their own NVRTC module (a4kKernelText), every texture stored as fp16 (libplacebo's rgba16f).
// A layer = 12 channels as three 4-channel fp16 textures, texture k of pixel i at t[k * ps + i] (8 bytes); 3 x 3 taps
// clamp at the edges (texOff's clamp-to-edge). conv2d_tf (layer 0) and the last 1 x 1 = the shader's fp32 math with
// every weight a float literal in the text (an FFMA immediate, like the shader's literal mat4s); conv2d_1 .. _6 = the
// tensor-core kernels of kA4kMma. Built at the first Anime4K session's setup and cached beside the main kernels' cubin.
static const char kA4kHead[] = R"A4KSRC(
// the tensor-core instruction: sm_80+ as written; sm_75 (RTX 20) = its two k8 halves, the trailing `//` turns the call
// site's k16 operand list into a PTX comment
#if __CUDA_ARCH__ >= 800
#define SMV_MMA_F16 "mma.sync.aligned.m16n8k16.row.col.f16.f16.f16.f16 "
#else
// fp16 sums: both halves on fp32 accumulators, rounded to fp16 once (as the sm_80 instruction rounds)
#define SMV_MMA_F16                                                                                                    \
    "{\n.reg .f16 smvh<4>;\n.reg .f32 smvf<4>;\nmov.b32 {smvh0, smvh1}, %0;\nmov.b32 {smvh2, smvh3}, %1;\n"           \
    "cvt.f32.f16 smvf0, smvh0;\ncvt.f32.f16 smvf1, smvh1;\ncvt.f32.f16 smvf2, smvh2;\ncvt.f32.f16 smvf3, smvh3;\n"    \
    "mma.sync.aligned.m16n8k8.row.col.f32.f16.f16.f32 {smvf0,smvf1,smvf2,smvf3}, {%2,%3}, {%6}, "                     \
    "{smvf0,smvf1,smvf2,smvf3};\n"                                                                                     \
    "mma.sync.aligned.m16n8k8.row.col.f32.f16.f16.f32 {smvf0,smvf1,smvf2,smvf3}, {%4,%5}, {%7}, "                     \
    "{smvf0,smvf1,smvf2,smvf3};\n"                                                                                     \
    "cvt.rn.f16.f32 smvh0, smvf0;\ncvt.rn.f16.f32 smvh1, smvf1;\ncvt.rn.f16.f32 smvh2, smvf2;\n"                      \
    "cvt.rn.f16.f32 smvh3, smvf3;\nmov.b32 %0, {smvh0, smvh1};\nmov.b32 %1, {smvh2, smvh3};\n} // "
#endif
extern "C" {
__device__ __forceinline__ float h2f(unsigned short h)
{
    float f;
    asm("cvt.f32.f16 %0, %1;" : "=f"(f) : "h"(h));
    return f;
}
__device__ __forceinline__ unsigned short f2h(float f)
{
    unsigned short h;
    asm("cvt.rn.f16.f32 %0, %1;" : "=h"(h) : "f"(f));
    return h;
}
struct A4kLast4
{
    const uint2* l[4]; // conv2d_2 .. conv2d_5 (conv2d_6 = the fused kernel's own sums)
};
__device__ __forceinline__ unsigned int a4kPack(float a, float b)
{
    return (unsigned int)f2h(a) | ((unsigned int)f2h(b) << 16);
}
)A4KSRC";

// conv2d_1 .. conv2d_6 on the tensor cores with fp16 sums: the previous layer's 12 channels -> CReLU (24: 0..11 =
// max(x, 0), 12..23 = max(-x, 0)) -> 3 x 3 -> 12 + bias. Implicit GEMM, mma.sync m16n8k16: M = pixels, N = 12 outputs
// (two n-tiles, the second half empty), K = 9 taps x 24 channels = 27 chunks of 8 halves (14 k-steps, the last half on a
// zero chunk); A = the stored fp16 values (exact), B = the weights rounded to fp16 once (nativeA4kModule fills g_a4kWf
// in fragment order, [layer][step][lane] = n-tile 0 b0 b1, n-tile 1 b0 b1, and g_a4kB with the fp32 biases; layers 0..5
// = the Upscale net's conv2d_1..6, 6..12 = the Restore net's conv2d_1..7). A block =
// 4 warps on an 8 x 32 pixel tile, its 10 x 34 halo in shared memory at 48 B a pixel (3 chunks: an odd stride, so each
// ldmatrix row group hits 8 bank groups), CReLU on the load; the weights a k-step ahead. k_a4kConvM16 = conv2d_2 ..
// conv2d_5; a4kKernelText writes k_a4kConvM16First (conv2d_tf computed on conv2d_1's halo, then conv2d_1) and
// k_a4kConvM16Last (conv2d_6, then the last 1 x 1) from the same pieces (AM_SETUP, AM_LOOP, AM_STORE).
static const char kA4kMma[] = R"A4KSRC(
__device__ uint4 g_a4kWf[13 * 14 * 32];
__device__ float g_a4kB[13 * 12];
#define AM_HW 34
#define AM_HH 10
#define AM_ZERO (AM_HH * AM_HW * 3)
__device__ __forceinline__ void amLdm4(unsigned addr, unsigned* r)
{
    asm volatile("ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%0,%1,%2,%3}, [%4];\n"
                 : "=r"(r[0]), "=r"(r[1]), "=r"(r[2]), "=r"(r[3])
                 : "r"(addr));
}
// CReLU on a packed half2: max(x, 0) and max(-x, 0) per half (sign-bit masks: exact)
__device__ __forceinline__ unsigned amPos(unsigned u)
{
    const unsigned m = ((u >> 15) & 0x00010001u) * 0xffffu;
    return u & ~m;
}
__device__ __forceinline__ unsigned amNeg(unsigned u)
{
    const unsigned m = ((u >> 15) & 0x00010001u) * 0xffffu;
    return u & 0x7fff7fffu & m;
}
// the 10 x 34 halo (clamped to the frame) as 24 CReLU halves a pixel (chunk 0 = c 0..7, 1 = c 8..15, 2 = c 16..23),
// then one zero chunk
__device__ __forceinline__ void amHalo(uint4* __restrict__ s, const uint2* __restrict__ in, int w, int h, int tx0,
                                       int ty0)
{
    const size_t ps = (size_t)w * h;
    for (int p = threadIdx.x; p < AM_HH * AM_HW; p += 128)
    {
        const int hr = p / AM_HW, hc = p - hr * AM_HW;
        const int gy = min(max(ty0 - 1 + hr, 0), h - 1), gx = min(max(tx0 - 1 + hc, 0), w - 1);
        const size_t g = (size_t)gy * w + gx;
        const uint2 a = in[g], b = in[ps + g], c = in[2 * ps + g];
        s[p * 3 + 0] = make_uint4(amPos(a.x), amPos(a.y), amPos(b.x), amPos(b.y));
        s[p * 3 + 1] = make_uint4(amPos(c.x), amPos(c.y), amNeg(a.x), amNeg(a.y));
        s[p * 3 + 2] = make_uint4(amNeg(b.x), amNeg(b.y), amNeg(c.x), amNeg(c.y));
    }
    if (threadIdx.x == 0)
        s[AM_ZERO] = make_uint4(0, 0, 0, 0);
    __syncthreads();
}
// chunk q (0..26) of K: tap q / 3 (dy, dx), channel chunk q % 3: its offset in chunks from a pixel's first chunk
#define AM_OFF(q) ((((q) / 3) / 3 * AM_HW + ((q) / 3) % 3) * 3 + (q) % 3)
// a layer's shared tile, block origin and weights (layer in scope)
#define AM_SETUP                                                                                                       \
        __shared__ __align__(16) uint4 s[AM_ZERO + 1];                                                                 \
        const uint4* wf = g_a4kWf + layer * 14 * 32;                                                                   \
        const float* bias = g_a4kB + layer * 12;                                                                       \
        const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;                                                    \
        const int tx0 = blockIdx.x * 32, ty0 = blockIdx.y * 8;                                                         \
        uint4 bc = __ldg(wf + lane), bn;
// the mma main loop over the filled halo and its zero chunk (leaves acc, g, t4)
#define AM_LOOP(ACC16)                                                                                                 \
        const unsigned sb = (unsigned)__cvta_generic_to_shared(s);                                                     \
        const int g = lane >> 2, t4 = lane & 3;                                                                        \
        const int arow = (lane & 7) + ((lane >> 3) & 1) * 8, akc = lane >> 4;                                          \
        int pb[4];                                                                                                     \
        _Pragma("unroll") for (int mi = 0; mi < 4; ++mi) pb[mi] =                                                      \
            ((2 * warp + (mi >> 1)) * AM_HW + (mi & 1) * 16 + arow) * 3;                                               \
        AM_ACC_DECL_##ACC16;                                                                                           \
        _Pragma("unroll") for (int st = 0; st < 14; ++st)                                                              \
        {                                                                                                              \
            if (st + 1 < 14)                                                                                           \
                bn = __ldg(wf + (st + 1) * 32 + lane);                                                                 \
            const int qa = 2 * st, qb = 2 * st + 1;                                                                    \
            const int off = akc ? (qb < 27 ? AM_OFF(qb) : -1) : AM_OFF(qa);                                            \
            _Pragma("unroll") for (int mi = 0; mi < 4; ++mi)                                                           \
            {                                                                                                          \
                unsigned a[4];                                                                                         \
                const unsigned addr = off < 0 ? sb + AM_ZERO * 16 : sb + (unsigned)(pb[mi] + off) * 16;                \
                amLdm4(addr, a);                                                                                       \
                AM_MMA_##ACC16(mi, 0, bc.x, bc.y);                                                                     \
                AM_MMA_##ACC16(mi, 1, bc.z, bc.w);                                                                     \
            }                                                                                                          \
            bc = bn;                                                                                                   \
        }
// the generic epilogue: the 12 outputs into the three fp16 textures
#define AM_STORE(ACC16)                                                                                                \
        const size_t ps = (size_t)w * h;                                                                               \
        _Pragma("unroll") for (int nt = 0; nt < 2; ++nt)                                                               \
        {                                                                                                              \
            const int n0 = nt * 8 + t4 * 2;                                                                            \
            if (n0 >= 12)                                                                                              \
                continue;                                                                                              \
            _Pragma("unroll") for (int mi = 0; mi < 4; ++mi)                                                           \
            {                                                                                                          \
                const int gy = ty0 + 2 * warp + (mi >> 1);                                                             \
                if (gy >= h)                                                                                           \
                    continue;                                                                                          \
                _Pragma("unroll") for (int hh = 0; hh < 2; ++hh)                                                       \
                {                                                                                                      \
                    const int gx = tx0 + (mi & 1) * 16 + g + hh * 8;                                                   \
                    if (gx >= w)                                                                                       \
                        continue;                                                                                      \
                    unsigned* o = (unsigned*)(out + (n0 >> 2) * ps + (size_t)gy * w + gx) + ((n0 & 3) >> 1);           \
                    *o = AM_PACK_##ACC16(mi, nt, hh);                                                                  \
                }                                                                                                      \
            }                                                                                                          \
        }
#define AM_KERNEL(NAME, ACC16)                                                                                         \
    __global__ void __launch_bounds__(128) NAME(const uint2* __restrict__ in, int w, int h, uint2* __restrict__ out,   \
                                                int layer)                                                             \
    {                                                                                                                  \
        AM_SETUP                                                                                                       \
        amHalo(s, in, w, h, tx0, ty0);                                                                                 \
        AM_LOOP(ACC16)                                                                                                 \
        AM_STORE(ACC16)                                                                                                \
    }
// fp16 sums: acc[mi][nt][2] packed half2 (row g, row g + 8)
#define AM_ACC_DECL_1                                                                                                  \
    unsigned acc[4][2][2];                                                                                             \
    _Pragma("unroll") for (int nt = 0; nt < 2; ++nt)                                                                   \
    {                                                                                                                  \
        const int n0 = nt * 8 + t4 * 2;                                                                                \
        const unsigned b2 = n0 < 12 ? a4kPack(bias[n0], bias[n0 + 1]) : 0u;                                            \
        _Pragma("unroll") for (int mi = 0; mi < 4; ++mi) acc[mi][nt][0] = acc[mi][nt][1] = b2;                         \
    }
#define AM_MMA_1(mi, nt, b0, b1)                                                                                       \
    asm volatile(SMV_MMA_F16 "{%0,%1}, {%2,%3,%4,%5}, {%6,%7}, {%0,%1};\n"      \
                 : "+r"(acc[mi][nt][0]), "+r"(acc[mi][nt][1])                                                          \
                 : "r"(a[0]), "r"(a[1]), "r"(a[2]), "r"(a[3]), "r"(b0), "r"(b1))
#define AM_PACK_1(mi, nt, hh) (acc[mi][nt][hh])
AM_KERNEL(k_a4kConvM16, 1)
)A4KSRC";

// k_a4kConvM16First's tile fill: the source (three fp16 planes, R, G, B: k_restIn's) as a clamped 12 x 36 tile, then
// conv2d_tf (a4kC0At) at each of conv2d_1's 10 x 34 halo pixels' clamped position, rounded to fp16 as its texture would
// be and CReLU'd into the mma's chunks (amHalo's layout): conv2d_tf never reaches memory
static const char kA4kFirstFill[] = R"A4KSRC(    __shared__ float st[3 * 12 * 36];
    const size_t psrc = (size_t)w * h;
    for (int i = threadIdx.x; i < 12 * 36; i += 128)
    {
        const int r = i / 36, c = i - r * 36;
        const int gy = min(max(ty0 - 2 + r, 0), h - 1), gx = min(max(tx0 - 2 + c, 0), w - 1);
        const size_t gi = (size_t)gy * w + gx;
#pragma unroll
        for (int ch = 0; ch < 3; ch++)
            st[ch * 432 + i] = h2f(src[ch * psrc + gi]);
    }
    __syncthreads();
    for (int p = threadIdx.x; p < AM_HH * AM_HW; p += 128)
    {
        const int hr = p / AM_HW, hc = p - hr * AM_HW;
        const int cy = min(max(ty0 - 1 + hr, 0), h - 1), cx = min(max(tx0 - 1 + hc, 0), w - 1);
        unsigned hv[6];
        a4kC0At(st + (cy - ty0 + 1) * 36 + (cx - tx0 + 1), hv);
        s[p * 3 + 0] = make_uint4(amPos(hv[0]), amPos(hv[1]), amPos(hv[2]), amPos(hv[3]));
        s[p * 3 + 1] = make_uint4(amPos(hv[4]), amPos(hv[5]), amNeg(hv[0]), amNeg(hv[1]));
        s[p * 3 + 2] = make_uint4(amNeg(hv[2]), amNeg(hv[3]), amNeg(hv[4]), amNeg(hv[5]));
    }
    if (threadIdx.x == 0)
        s[AM_ZERO] = make_uint4(0, 0, 0, 0);
    __syncthreads();
)A4KSRC";

// k_a4kConvM16Last's middle: conv2d_6's fp16 sums (the values its texture would hold) staged per pixel in the freed
// halo, then each thread takes two of the tile's pixels for the last 1 x 1
static const char kA4kLastStage[] = R"A4KSRC(    __syncthreads();
    unsigned short* s6 = (unsigned short*)s;
#pragma unroll
    for (int nt = 0; nt < 2; ++nt)
    {
        const int n0 = nt * 8 + t4 * 2;
        if (n0 >= 12)
            continue;
#pragma unroll
        for (int mi = 0; mi < 4; ++mi)
#pragma unroll
            for (int hh = 0; hh < 2; ++hh)
                *(unsigned*)(s6 + ((2 * warp + (mi >> 1)) * 32 + (mi & 1) * 16 + g + hh * 8) * 12 + n0) =
                    acc[mi][nt][hh];
    }
    __syncthreads();
    const size_t ps = (size_t)w * h;
    for (int p = threadIdx.x; p < 256; p += 128)
    {
        const int gx = tx0 + (p & 31), gy = ty0 + (p >> 5);
        if (gx >= w || gy >= h)
            continue;
        const size_t i = (size_t)gy * w + gx;
        float pos, neg, r[4];
        uint2 q;
)A4KSRC";

// Clamp_Highlights (Anime4K_Clamp_Highlights.glsl, part of every Anime4K mode): before a chain, the luma (0.299, 0.587,
// 0.114) of the source as three fp16 planes and its 5 x 5 maximum, two separable passes, each stored fp16 as the
// shader's STATSMAX texture is; after the chain, every pixel of the planar fp32 output (the nets' values as they made
// them, outside 0..1 too, as the shader's rgba16f textures hold them) whose luma exceeds the maximum sampled
// bilinearly at its position (texel centres, clamp-to-edge, the shader's `STATSMAX_tex(HOOKED_pos)`) is lowered by the
// excess on all three channels (`HOOKED - (luma - min(luma, max))`), then every channel clipped to 0..1 (the output;
// clip 0 = the values go on to a Lanczos fit that clips). k_a4kClamp = Restore's chain and the resize's after Mode A+A's
// second Restore; the resize's chain otherwise clamps inside its last fold (a4kFoldPx, before the Lanczos fit).
static const char kA4kClampSrc[] = R"A4KSRC(
__device__ __forceinline__ float a4kLuma(float r, float g, float b)
{
    return 0.299f * r + 0.587f * g + 0.114f * b;
}
__global__ void k_a4kStatH(const unsigned short* __restrict__ in, int w, int h, unsigned short* __restrict__ tmp)
{
    const int x = blockIdx.x * blockDim.x + threadIdx.x, y = blockIdx.y * blockDim.y + threadIdx.y;
    if (x >= w || y >= h)
        return;
    const size_t ps = (size_t)w * h, row = (size_t)y * w;
    float m = 0.0f;
    for (int d = -2; d <= 2; d++)
    {
        const size_t i = row + (size_t)min(max(x + d, 0), w - 1);
        m = fmaxf(m, a4kLuma(h2f(in[i]), h2f(in[ps + i]), h2f(in[2 * ps + i])));
    }
    tmp[row + x] = f2h(m);
}
__global__ void k_a4kStatV(const unsigned short* __restrict__ tmp, int w, int h, unsigned short* __restrict__ stat)
{
    const int x = blockIdx.x * blockDim.x + threadIdx.x, y = blockIdx.y * blockDim.y + threadIdx.y;
    if (x >= w || y >= h)
        return;
    float m = 0.0f;
    for (int d = -2; d <= 2; d++)
        m = fmaxf(m, h2f(tmp[(size_t)min(max(y + d, 0), h - 1) * w + x]));
    stat[(size_t)y * w + x] = f2h(m);
}
__global__ void k_a4kClamp(float* __restrict__ img, int tw, int th, const unsigned short* __restrict__ stat, int sw,
                           int sh, int clip)
{
    const int x = blockIdx.x * blockDim.x + threadIdx.x, y = blockIdx.y * blockDim.y + threadIdx.y;
    if (x >= tw || y >= th)
        return;
    const size_t ps = (size_t)tw * th, i = (size_t)y * tw + x;
    const float r = img[i], g = img[ps + i], b = img[2 * ps + i];
    const float cur = a4kLuma(r, g, b);
    const float fx = ((float)x + 0.5f) * (float)sw / (float)tw - 0.5f;
    const float fy = ((float)y + 0.5f) * (float)sh / (float)th - 0.5f;
    const float x0f = floorf(fx), y0f = floorf(fy);
    const float ax = fx - x0f, ay = fy - y0f;
    const int x0 = min(max((int)x0f, 0), sw - 1), x1 = min(max((int)x0f + 1, 0), sw - 1);
    const int y0 = min(max((int)y0f, 0), sh - 1), y1 = min(max((int)y0f + 1, 0), sh - 1);
    const float s00 = h2f(stat[(size_t)y0 * sw + x0]), s10 = h2f(stat[(size_t)y0 * sw + x1]);
    const float s01 = h2f(stat[(size_t)y1 * sw + x0]), s11 = h2f(stat[(size_t)y1 * sw + x1]);
    const float mx = (s00 + (s10 - s00) * ax) + ((s01 + (s11 - s01) * ax) - (s00 + (s10 - s00) * ax)) * ay;
    const float d = cur - fminf(cur, mx);
    const float o[3] = {r - d, g - d, b - d};
    for (int c = 0; c < 3; c++)
        img[(size_t)c * ps + i] = !clip ? o[c] : (o[c] < 0.0f ? 0.0f : (o[c] > 1.0f ? 1.0f : o[c]));
}
)A4KSRC";

// one weight as an exact float literal: the hex form of its own bits (printf %a, the mantissa's trailing zeros cut)
static void a4kLit(std::string& s, uint32_t bits)
{
    float v = 0.0f;
    memcpy(&v, &bits, sizeof v);
    char b[48];
    snprintf(b, sizeof b, "%a", (double)v);
    const char* p = strchr(b, 'p');
    std::string m(b, p ? (size_t)(p - b) : strlen(b));
    if (m.find('.') != std::string::npos)
    {
        while (m.back() == '0')
            m.pop_back();
        if (m.back() == '.')
            m.pop_back();
    }
    s += m;
    if (p)
        s += p;
    s += 'f';
}

// the module's whole text: kA4kMma's pieces and k_a4kConvM16 (conv2d_2 .. _5); a4kC0At = conv2d_tf at one pixel (t =
// its 3 x 3 window's top-left in the [3][12][36] source tile; its 12 sums as 6 packed half2; the literal weights in the
// shader's order: the bias, then channel, tap, output); k_a4kConvM16First (conv2d_tf on conv2d_1's halo, then
// conv2d_1); k_a4kConvM16Last (conv2d_6, then the 1 x 1 over the CReLU of conv2d_2 .. _6 with literal weights, per
// output by layer, texture, channel, pos then neg -> the three last textures as 12 fp16 planes, plane 4 k + j = texture
// k's channel j: k_a4kFoldHSub's input)
static void a4kKernelText(std::string& s)
{
    s.reserve((size_t)1 << 20);
    s = kA4kHead;
    s += kA4kMma;
    char ln[320];
    // a net's conv2d_tf at one pixel (`name`, its literal weights from `w0`: the bias, then channel, tap, output) and its
    // first kernel (`kernel`: conv2d_tf on conv2d_1's halo, then conv2d_1 = weights index `layer`)
    auto firstKernel = [&](const char* name, const char* kernel, const uint32_t* w0, int layer) {
        sprintf_s(ln, "__device__ __forceinline__ void %s(const float* __restrict__ t, unsigned* __restrict__ h6)\n{\n",
                  name);
        s += ln;
        s += "    float v;\n    float acc[12] = {";
        for (int o = 0; o < 12; o++)
        {
            a4kLit(s, w0[3 * 9 * 12 + o]);
            s += o < 11 ? ", " : "};\n";
        }
        for (int c = 0; c < 3; c++)
            for (int t = 0; t < 9; t++)
            {
                sprintf_s(ln, "    v = t[%d];\n", c * 432 + (t / 3) * 36 + t % 3);
                s += ln;
                for (int o = 0; o < 12; o++)
                {
                    sprintf_s(ln, "    acc[%d] = fmaf(", o);
                    s += ln;
                    a4kLit(s, w0[((size_t)o * 3 + c) * 9 + t]);
                    sprintf_s(ln, ", v, acc[%d]);\n", o);
                    s += ln;
                }
            }
        s +=
            "#pragma unroll\n    for (int k = 0; k < 6; k++)\n        h6[k] = a4kPack(acc[2 * k], acc[2 * k + 1]);\n}\n";
        sprintf_s(ln,
                  "__global__ void __launch_bounds__(128) %s(const unsigned short* __restrict__ src, int w, int h, "
                  "uint2* __restrict__ out)\n{\n    const int layer = %d;\n    AM_SETUP\n",
                  kernel, layer);
        s += ln;
        std::string fill = kA4kFirstFill;
        for (size_t p = fill.find("a4kC0At("); p != std::string::npos; p = fill.find("a4kC0At(", p + 1))
            fill.replace(p, 8, std::string(name) + "(");
        s += fill;
        s += "    AM_LOOP(1)\n    AM_STORE(1)\n}\n";
    };
    firstKernel("a4kC0At", "k_a4kConvM16First", kA4kWeights, 0);
    firstKernel("a4kR0At", "k_a4kRestFirst", kA4kRestWeights, 6);
    const uint32_t* wl = kA4kWeights + kA4kW0 + 6 * kA4kW;
    s +=
        "__global__ void __launch_bounds__(128) k_a4kConvM16Last(const uint2* __restrict__ in, int w, int h, A4kLast4 l, "
        "unsigned short* __restrict__ out)\n{\n    const int layer = 5;\n    AM_SETUP\n"
        "    amHalo(s, in, w, h, tx0, ty0);\n    AM_LOOP(1)\n";
    s += kA4kLastStage;
    s += "        float z[12] = {";
    for (int o = 0; o < 12; o++)
    {
        a4kLit(s, wl[1440 + o]);
        s += o < 11 ? ", " : "};\n";
    }
    for (int L = 0; L < 5; L++)
        for (int k = 0; k < 3; k++)
        {
            if (L < 4)
            {
                sprintf_s(ln, "        q = l.l[%d][%d * ps + i];\n", L, k);
                s += ln;
                s += "        r[0] = h2f((unsigned short)(q.x & 0xffff)); r[1] = h2f((unsigned short)(q.x >> 16));\n"
                     "        r[2] = h2f((unsigned short)(q.y & 0xffff)); r[3] = h2f((unsigned short)(q.y >> 16));\n";
            }
            else
            {
                sprintf_s(ln,
                          "        r[0] = h2f(s6[p * 12 + %d]); r[1] = h2f(s6[p * 12 + %d]); r[2] = h2f(s6[p * 12 + "
                          "%d]); r[3] = h2f(s6[p * 12 + %d]);\n",
                          4 * k, 4 * k + 1, 4 * k + 2, 4 * k + 3);
                s += ln;
            }
            for (int j = 0; j < 4; j++)
            {
                sprintf_s(ln, "        pos = fmaxf(r[%d], 0.0f); neg = fmaxf(-r[%d], 0.0f);\n", j, j);
                s += ln;
                for (int o = 0; o < 12; o++)
                {
                    sprintf_s(ln, "        z[%d] = fmaf(", o);
                    s += ln;
                    a4kLit(s, wl[(size_t)o * 120 + 24 * L + 4 * k + j]);
                    sprintf_s(ln, ", pos, z[%d]);\n        z[%d] = fmaf(", o, o);
                    s += ln;
                    a4kLit(s, wl[(size_t)o * 120 + 24 * L + 12 + 4 * k + j]);
                    sprintf_s(ln, ", neg, z[%d]);\n", o);
                    s += ln;
                }
            }
        }
    s += "#pragma unroll\n        for (int o = 0; o < 12; o++)\n            out[o * ps + i] = f2h(z[o]);\n    }\n}\n";
    // the Restore net's last kernel: conv2d_7 (weights index 12), then its 1 x 1 over the CReLU of conv2d_3 .. _7 (3
    // outputs, literal weights), then the shader's `result + MAIN` (the source's fp16 planes added back) into the planar
    // fp32 output, NOT clipped (the chain's end clips: k_a4kClamp, or the resize's last fold after Mode A's Upscale)
    const uint32_t* rl = kA4kRestWeights + kA4kW0 + 7 * kA4kW;
    s +=
        "__global__ void __launch_bounds__(128) k_a4kRestLast(const uint2* __restrict__ in, int w, int h, A4kLast4 l, "
        "const unsigned short* __restrict__ src, float* __restrict__ out)\n{\n    const int layer = 12;\n    AM_SETUP\n"
        "    amHalo(s, in, w, h, tx0, ty0);\n    AM_LOOP(1)\n";
    s += kA4kLastStage;
    s += "        float z[3] = {";
    for (int o = 0; o < 3; o++)
    {
        a4kLit(s, rl[360 + o]);
        s += o < 2 ? ", " : "};\n";
    }
    for (int L = 0; L < 5; L++)
        for (int k = 0; k < 3; k++)
        {
            if (L < 4)
            {
                sprintf_s(ln, "        q = l.l[%d][%d * ps + i];\n", L, k);
                s += ln;
                s += "        r[0] = h2f((unsigned short)(q.x & 0xffff)); r[1] = h2f((unsigned short)(q.x >> 16));\n"
                     "        r[2] = h2f((unsigned short)(q.y & 0xffff)); r[3] = h2f((unsigned short)(q.y >> 16));\n";
            }
            else
            {
                sprintf_s(ln,
                          "        r[0] = h2f(s6[p * 12 + %d]); r[1] = h2f(s6[p * 12 + %d]); r[2] = h2f(s6[p * 12 + "
                          "%d]); r[3] = h2f(s6[p * 12 + %d]);\n",
                          4 * k, 4 * k + 1, 4 * k + 2, 4 * k + 3);
                s += ln;
            }
            for (int j = 0; j < 4; j++)
            {
                sprintf_s(ln, "        pos = fmaxf(r[%d], 0.0f); neg = fmaxf(-r[%d], 0.0f);\n", j, j);
                s += ln;
                for (int o = 0; o < 3; o++)
                {
                    sprintf_s(ln, "        z[%d] = fmaf(", o);
                    s += ln;
                    a4kLit(s, rl[(size_t)o * 120 + 24 * L + 4 * k + j]);
                    sprintf_s(ln, ", pos, z[%d]);\n        z[%d] = fmaf(", o, o);
                    s += ln;
                    a4kLit(s, rl[(size_t)o * 120 + 24 * L + 12 + 4 * k + j]);
                    sprintf_s(ln, ", neg, z[%d]);\n", o);
                    s += ln;
                }
            }
        }
    s += "#pragma unroll\n        for (int o = 0; o < 3; o++)\n        {\n"
         "            out[o * ps + i] = z[o] + h2f(src[o * ps + i]);\n        }\n    }\n}\n";
    s += kA4kClampSrc;
    s += "} // extern \"C\"\n";
}

static uint16_t halfBitsRne(float f);

// the six 3 x 3 layers' weights for kA4kMma: wf = [layer][14 k-steps][32 lanes][4] = n-tile 0 b0 b1, n-tile 1 b0 b1, each
// register two fp16 weights (K rows k0, k0 + 1 at output g of the n-tile; lane = 4 g + k0 / 2, b1 = rows + 8); K row
// kl of k-step st = chunk q = 2 st + kl / 8 (tap q / 3, channel (q % 3) * 8 + kl % 8), chunk 27 and outputs 12..15 zero;
// b = the fp32 biases
static void a4kFragments(std::vector<uint32_t>& wf, std::vector<float>& b)
{
    wf.assign((size_t)13 * 14 * 32 * 4, 0u);
    b.assign(13 * 12, 0.0f);
    for (int L = 0; L < 13; L++)
    {
        // 0..5 = the Upscale net's conv2d_1..6, 6..12 = the Restore net's conv2d_1..7
        const uint32_t* blk =
            L < 6 ? kA4kWeights + kA4kW0 + (size_t)L * kA4kW : kA4kRestWeights + kA4kW0 + (size_t)(L - 6) * kA4kW;
        auto wh = [&](int st, int kl, int n) -> uint32_t {
            const int q = 2 * st + kl / 8;
            if (q >= 27 || n >= 12)
                return 0u;
            const int tap = q / 3, c = (q % 3) * 8 + kl % 8;
            float v;
            memcpy(&v, &blk[((size_t)n * 24 + c) * 9 + tap], sizeof v);
            return halfBitsRne(v);
        };
        for (int st = 0; st < 14; st++)
            for (int lane = 0; lane < 32; lane++)
            {
                const int g = lane >> 2, k0 = (lane & 3) * 2;
                uint32_t* e = &wf[(((size_t)L * 14 + st) * 32 + lane) * 4];
                for (int nt = 0; nt < 2; nt++)
                {
                    const int n = nt * 8 + g;
                    e[2 * nt] = wh(st, k0, n) | (wh(st, k0 + 1, n) << 16);
                    e[2 * nt + 1] = wh(st, k0 + 8, n) | (wh(st, k0 + 9, n) << 16);
                }
            }
        for (int o = 0; o < 12; o++)
            memcpy(&b[(size_t)L * 12 + o], &blk[24 * 9 * 12 + o], sizeof(float));
    }
}

// this session's Anime4K module: its text compiled (or the cached cubin) and loaded, its three kernels bound and
// kA4kMma's weights uploaded; false = `why` says what failed (the session teardown unloads a module left in a4kMod)
static bool nativeA4kModule(NativeRife& nr, std::string& why)
{
    std::lock_guard<std::mutex> lk(nr.mA4k); // Restore's and the resize's setups may ask at the same time (live)
    if (nr.a4kMod)
        return true;
    std::string text;
    a4kKernelText(text);
    std::vector<char> cubin;
    if (!nativeCubin(text.c_str(), "smv_anime4k.cu", L"smv_anime4k", "Anime4K kernels",
                     nr.kernCacheDir.empty() ? std::wstring(L".") : nr.kernCacheDir, cubin))
    {
        why = "its kernels did not compile";
        return false;
    }
    if (cuModuleLoadData(&nr.a4kMod, cubin.data()) != CUDA_SUCCESS)
    {
        nr.a4kMod = nullptr;
        why = "its kernel module did not load";
        return false;
    }
    static const char* const kNames[8] = {"k_a4kConvM16First", "k_a4kConvM16", "k_a4kConvM16Last", "k_a4kRestFirst",
                                          "k_a4kRestLast",     "k_a4kStatH",   "k_a4kStatV",       "k_a4kClamp"};
    for (int i = 0; i < 8; i++)
        if (cuModuleGetFunction(&nr.fA4k[i], nr.a4kMod, kNames[i]) != CUDA_SUCCESS)
        {
            why = std::string("its kernel ") + kNames[i] + " is missing";
            return false;
        }
    std::vector<uint32_t> wf;
    std::vector<float> b;
    a4kFragments(wf, b);
    CUdeviceptr gw = 0, gb = 0;
    size_t sw = 0, sb = 0;
    if (cuModuleGetGlobal(&gw, &sw, nr.a4kMod, "g_a4kWf") != CUDA_SUCCESS || sw != wf.size() * sizeof(uint32_t) ||
        cuModuleGetGlobal(&gb, &sb, nr.a4kMod, "g_a4kB") != CUDA_SUCCESS || sb != b.size() * sizeof(float) ||
        cuMemcpyHtoD(gw, wf.data(), sw) != CUDA_SUCCESS || cuMemcpyHtoD(gb, b.data(), sb) != CUDA_SUCCESS)
    {
        why = "its weights did not upload";
        return false;
    }
    return true;
}

// the conv passes of one net on st at w x h, 4 warps a 32 x 8 tile each: in (three fp16 planes) -> the net's first
// kernel -> k_a4kConvM16 over its middle layers -> its last kernel. The Upscale net (restore false, weights 0..5):
// k_a4kConvM16First (conv2d_tf + conv2d_1) -> conv2d_2 .. _5 -> k_a4kConvM16Last (conv2d_6 + the 1 x 1) -> out, the
// three last textures as 12 fp16 planes. The Restore net (restore true, weights 6..12): k_a4kRestFirst (conv2d_tf +
// conv2d_1) -> conv2d_2 .. _6 -> k_a4kRestLast (conv2d_7 + the 1 x 1 + the source) -> out, planar fp32. Four layer
// slots (layer L -> slot (L - 1) & 3: a layer's only reader has run before its slot is rewritten; the four layers the
// 1 x 1 reads are the last four written)
static bool nativeA4kPasses(NativeRife& nr, cudaStream_t st, const void* in, int w, int h, void* slots, void* out,
                            bool restore)
{
    const size_t lb = (size_t)3 * w * h * 8;
    auto slot = [&](int L) { return (void*)((char*)slots + (size_t)((L - 1) & 3) * lb); };
    const unsigned gx = (unsigned)(w + 31) / 32, gy = (unsigned)(h + 7) / 8;
    const int mid = restore ? 6 : 5;  // the last of the layers k_a4kConvM16 runs (2 .. mid)
    const int base = restore ? 6 : 0; // the net's first weights index
    void* t1 = slot(1);
    void* a0[] = {(void*)&in, &w, &h, &t1};
    if (cuLaunchKernel(nr.fA4k[restore ? 3 : 0], gx, gy, 1, 128, 1, 1, 0, (CUstream)st, a0, nullptr) != CUDA_SUCCESS)
        return false;
    for (int L = 2; L <= mid; L++)
    {
        int layer = base + L - 1;
        void *lin = slot(L - 1), *lout = slot(L);
        void* a[] = {&lin, &w, &h, &lout, &layer};
        if (cuLaunchKernel(nr.fA4k[1], gx, gy, 1, 128, 1, 1, 0, (CUstream)st, a, nullptr) != CUDA_SUCCESS)
            return false;
    }
    void* l4[4] = {slot(mid - 3), slot(mid - 2), slot(mid - 1), slot(mid)}; // A4kLast4: the 1 x 1's stored layers
    void* last = slot(mid);
    if (!restore)
    {
        void* al[] = {&last, &w, &h, l4, &out};
        return cuLaunchKernel(nr.fA4k[2], gx, gy, 1, 128, 1, 1, 0, (CUstream)st, al, nullptr) == CUDA_SUCCESS;
    }
    void* al[] = {&last, &w, &h, l4, (void*)&in, &out};
    return cuLaunchKernel(nr.fA4k[4], gx, gy, 1, 128, 1, 1, 0, (CUstream)st, al, nullptr) == CUDA_SUCCESS;
}

// the x2 passes a slot needs: the fewest whose 2^n reaches the enlarge ratio (up to 2x one, 3x two with Lanczos down
// from 4x), so the model makes every enlarged pixel and the fit only shrinks the overshoot; at most kA4kMaxPasses
// (Live's 64 px floor on an 8K panel = 67.5x = 7 passes; too little video memory drops passes, the fit then enlarges
// the rest)
static constexpr int kA4kMaxPasses = 7;
static int a4kPassesFor(int w, int h, int ow, int oh)
{
    int n = 1;
    while (n < kA4kMaxPasses && ((w << n) < ow || (h << n) < oh))
        n++;
    return n;
}

// Clamp_Highlights' statistics buffers for at least w x h pixels (a frame's first Anime4K pass's input size: Restore's
// and the resize's can differ in Live)
static bool nativeA4kStatAlloc(NativeRife& nr, int w, int h)
{
    std::lock_guard<std::mutex> lk(nr.mA4k); // the two setups (live: two threads) share the buffers
    const size_t n = (size_t)w * h;
    if (nr.a4kStatCap >= n)
        return true;
    for (unsigned short** p : {&nr.dA4kStat, &nr.dA4kStatTmp})
        if (*p)
        {
            cudaFree(*p);
            *p = nullptr;
        }
    nr.a4kStatCap = 0;
    if (cudaMalloc((void**)&nr.dA4kStat, n * sizeof(uint16_t)) != cudaSuccess ||
        cudaMalloc((void**)&nr.dA4kStatTmp, n * sizeof(uint16_t)) != cudaSuccess)
    {
        cudaGetLastError();
        return false;
    }
    nr.a4kStatCap = n;
    return true;
}

// the de-ringing switch: SMV_A4K_CLAMP=0 leaves a chain's output as its nets made it (the kit's byte gates)
static bool a4kClampOn()
{
    static const bool on = [] {
        wchar_t v[8]{};
        return !(GetEnvironmentVariableW(L"SMV_A4K_CLAMP", v, 8) && v[0] == L'0');
    }();
    return on;
}

// Clamp_Highlights' statistics: the 5 x 5 maximum of the luma of in (three fp16 planes, w x h) into dA4kStat
static bool nativeA4kStats(NativeRife& nr, const void* in, int w, int h, cudaStream_t st)
{
    if (!a4kClampOn())
        return true;
    void* a[] = {(void*)&in, &w, &h, &nr.dA4kStatTmp};
    if (cuLaunchKernel(nr.fA4k[5], (w + 15) / 16, (h + 15) / 16, 1, 16, 16, 1, 0, (CUstream)st, a, nullptr) !=
        CUDA_SUCCESS)
        return false;
    void* b[] = {&nr.dA4kStatTmp, &w, &h, &nr.dA4kStat};
    if (cuLaunchKernel(nr.fA4k[6], (w + 15) / 16, (h + 15) / 16, 1, 16, 16, 1, 0, (CUstream)st, b, nullptr) !=
        CUDA_SUCCESS)
        return false;
    nr.a4kStatW = w;
    nr.a4kStatH = h;
    return true;
}

// a chain's end on a planar frame: img (planar fp32, tw x th, the net's values) lowered where its luma exceeds the
// maximum's bilinear sample, then clipped to 0..1 (with SMV_A4K_CLAMP=0 only the clip); clip false = the values go on to
// a Lanczos fit that clips (Mode A+A's 2x frame)
static bool nativeA4kClamp(NativeRife& nr, float* img, int tw, int th, cudaStream_t st, bool clip = true)
{
    if (!a4kClampOn())
    {
        if (!clip)
            return true;
        int n = 3 * tw * th;
        void* c[] = {&img, &n};
        return cuLaunchKernel(nr.fClamp01, (n + 255) / 256, 1, 1, 256, 1, 1, 0, (CUstream)st, c, nullptr) ==
               CUDA_SUCCESS;
    }
    int clipI = clip ? 1 : 0;
    void* a[] = {&img, &tw, &th, &nr.dA4kStat, &nr.a4kStatW, &nr.a4kStatH, &clipI};
    return cuLaunchKernel(nr.fA4k[7], (tw + 15) / 16, (th + 15) / 16, 1, 16, 16, 1, 0, (CUstream)st, a, nullptr) ==
           CUDA_SUCCESS;
}

// the resize's buffers (nativeA4kSetup's), freed
static void nativeA4kUpFree(NativeRife& nr)
{
    for (void** p : {&nr.dA4kIn, &nr.dA4kT, &nr.dA4kOut, (void**)&nr.dA4kMid, (void**)&nr.dA4kTmp})
        if (*p)
        {
            cudaFree(*p);
            *p = nullptr;
        }
    nr.a4kW = nr.a4kH = nr.a4kOw = nr.a4kOh = 0;
    nr.a4kN = 1;
    nr.a4kAA = false;
}

// Anime4K at the slot's input size w x h (-> ow x oh after the fold): its kernel module (nativeA4kModule), the x2
// passes the ratio needs (a4kPassesFor; pass k runs at 2^k x the input, the buffers hold the largest; too little video
// memory = one pass fewer, Lanczos covers the rest), the statistics buffers, then one run of every kernel on zeros, so
// the first frame pays no first launch. A module that fails or no room for a single pass = Lanczos for the session
// (vsrFailed), with its line.
static bool nativeA4kSetup(NativeRife& nr, int w, int h, int ow, int oh, int upEnc)
{
    const auto t0 = std::chrono::steady_clock::now();
    std::string why;
    if (!nativeA4kModule(nr, why))
    {
        LOG("native: Anime4K unavailable (%s), Lanczos for the %s\n", why.c_str(), g_offline ? "render" : "session");
        nr.vsrFailed = true;
        return true;
    }
    int n = a4kPassesFor(w, h, ow, oh);
    // Mode A+A: Restore runs on the first pass's 2x frame too, so the input, layer slots and the 2x frame hold it; it
    // goes first when the memory is short (the room taken before allocating, no spill), then a pass
    bool aa = g_a4kAA;
    for (;;)
    {
        const int wm = w << (n - 1), hm = h << (n - 1);
        const size_t sp = (size_t)wm * hm, spa = (std::max)(sp, aa ? (size_t)4 * w * h : 0);
        const bool mid = n > 1 || aa;
        const uint64_t need = 3 * spa * sizeof(uint16_t) + 4 * 3 * spa * 8 + 12 * sp * sizeof(uint16_t) +
                              (mid ? 3 * spa * sizeof(float) : 0) + (uint64_t)3 * ow * 2 * hm * sizeof(float);
        const uint64_t room = aa ? nativeVideoMemoryRoom() : 0;
        if ((!aa || !room || room >= need) && cudaMalloc(&nr.dA4kIn, 3 * spa * sizeof(uint16_t)) == cudaSuccess &&
            cudaMalloc(&nr.dA4kT, 4 * 3 * spa * 8) == cudaSuccess &&
            cudaMalloc(&nr.dA4kOut, 12 * sp * sizeof(uint16_t)) == cudaSuccess &&
            (!mid || cudaMalloc((void**)&nr.dA4kMid, 3 * spa * sizeof(float)) == cudaSuccess) &&
            cudaMalloc((void**)&nr.dA4kTmp, (size_t)3 * ow * 2 * hm * sizeof(float)) == cudaSuccess &&
            nativeA4kStatAlloc(nr, w, h))
            break;
        cudaGetLastError();
        nativeA4kUpFree(nr);
        if (aa)
        {
            LOG("native: Anime4K A+A needs %.0f MiB of video memory, more than is free: Mode A for the %s\n",
                need / 1048576.0, g_offline ? "render" : "session");
            aa = false;
            continue;
        }
        if (n == 1)
        {
            LOG("native: Anime4K ran out of video memory, Lanczos for the %s\n", g_offline ? "render" : "session");
            nr.vsrFailed = true;
            return true;
        }
        n--;
    }
    nr.a4kW = w;
    nr.a4kH = h;
    nr.a4kN = n;
    nr.a4kOw = ow;
    nr.a4kOh = oh;
    nr.a4kAA = aa;
    const size_t sp0 = (size_t)w * h;
    NCHK(cudaMemsetAsync(nr.dA4kIn, 0, (aa ? 4 : 1) * 3 * sp0 * sizeof(uint16_t), nr.stream), "Anime4K warm-up clear");
    if (!nativeA4kStats(nr, nr.dA4kIn, w, h, nr.stream) ||
        !nativeA4kPasses(nr, nr.stream, nr.dA4kIn, w, h, nr.dA4kT, nr.dA4kOut, false) ||
        (aa && !nativeA4kPasses(nr, nr.stream, nr.dA4kIn, 2 * w, 2 * h, nr.dA4kT, nr.dA4kMid, true)))
    {
        LOG("native: Anime4K warm-up launch failed\n");
        return false;
    }
    NCHK(cudaStreamSynchronize(nr.stream), "Anime4K warm-up sync");
    char passes[48] = "", aaNote[64] = "";
    if (n > 1)
        sprintf_s(passes, " in %d x2 passes", n);
    if (aa)
        sprintf_s(aaNote, ", A+A (Restore CNN UL on the %dx%d frame)", 2 * w, 2 * h);
    LOG("native: %s upscale: Anime4K Upscale CNN x2 UL %dx%d -> %dx%d%s%s -> Lanczos %dx%d%s%s%s (CUDA passes, "
        "tensor-core layers with fp16 sums, %.1fs)\n",
        g_offline ? "offline" : "live", w, h, w << n, h << n, passes, aaNote, ow, oh,
        a4kClampOn() ? ", Clamp_Highlights" : "", nr.vsrPre ? ", the captured frame before the model" : "",
        nr.hdr ? ", on the HDR planes' SDR view" : (upEnc ? ", on the HDR video's SDR view" : ""),
        std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count());
    return true;
}

// one frame through Anime4K: s (planar, fp32 or fp16 by sHalf, plane / row strides ps_ / rs_) at the slot's input
// size, pass by pass: the fp16 input (k_restIn), the statistics on the first pass's input (unless this frame's Restore
// (Anime4K) took them), the conv passes on nr.stream, then the fold: a pass that is not the last writes its exact 2x
// frame (k_a4kFold2x, unclipped) into dA4kMid, the next pass's input; the last one the Depth-to-Space pass with
// Clamp_Highlights on the 2^n frame (the shader's PREKERNEL hook, before any resize) and the Lanczos pair from 2w x 2h
// to tw x th (one pass, k_a4kFold2x, when tw x th is exactly 2w x 2h) into dst (planar fp32, tight, clipped to 0..1)
static bool nativeA4kRun(NativeRife& nr, const void* s, int sHalf, int ps_, int rs_, float* dst, int tw, int th)
{
    cudaStream_t st = nr.stream;
    if (tw > nr.a4kOw)
    {
        nr.die("Anime4K fold target wider than its buffer");
        return false;
    }
    const void* src = s;
    int half = sHalf, ps = ps_, rs = rs_;
    const unsigned short* noStat = nullptr;
    const unsigned short* stat = a4kClampOn() ? nr.dA4kStat : nullptr;
    int zero = 0;
    for (int k = 0; k < nr.a4kN; k++)
    {
        int w = nr.a4kW << k, h = nr.a4kH << k;
        void* a[] = {(void*)&src, &half, &ps, &rs, &w, &h, &nr.dA4kIn};
        if (cuLaunchKernel(nr.fRestIn, (w + 15) / 16, (h + 15) / 16, 1, 16, 16, 1, 0, (CUstream)st, a, nullptr) !=
            CUDA_SUCCESS)
        {
            nr.die("Anime4K input launch failed");
            return false;
        }
        if (k == 0 && !nr.a4kStatFresh && !nativeA4kStats(nr, nr.dA4kIn, w, h, st))
        {
            nr.die("Anime4K statistics launch failed");
            return false;
        }
        if (!nativeA4kPasses(nr, st, nr.dA4kIn, w, h, nr.dA4kT, nr.dA4kOut, false))
        {
            nr.die("Anime4K pass launch failed");
            return false;
        }
        int one = 1, h2 = 2 * h;
        const bool aaHere = nr.a4kAA && k == 0; // Mode A+A: Restore on this pass's 2x frame before the chain goes on
        if (k + 1 < nr.a4kN || aaHere)
        {
            void* a2[] = {&nr.dA4kOut, &one, &nr.dA4kIn, &w, &h, &nr.dA4kMid, &noStat, &zero, &zero, &zero};
            if (cuLaunchKernel(nr.fA4kFold2x, (2 * w + 15) / 16, (h2 + 15) / 16, 1, 16, 16, 1, 0, (CUstream)st, a2,
                               nullptr) != CUDA_SUCCESS)
            {
                nr.die("Anime4K fold (2x, next pass) launch failed");
                return false;
            }
            src = nr.dA4kMid;
            half = 0;
            ps = 4 * w * h;
            rs = 2 * w;
            if (aaHere)
            {
                // the 2x frame as fp16 planes, Restore CNN UL's passes on it, its output (the net's values, unclipped)
                // back into dA4kMid: the next pass's input, or the chain's end below
                int w2 = 2 * w;
                void* ai[] = {(void*)&src, &half, &ps, &rs, &w2, &h2, &nr.dA4kIn};
                if (cuLaunchKernel(nr.fRestIn, (w2 + 15) / 16, (h2 + 15) / 16, 1, 16, 16, 1, 0, (CUstream)st, ai,
                                   nullptr) != CUDA_SUCCESS ||
                    !nativeA4kPasses(nr, st, nr.dA4kIn, w2, h2, nr.dA4kT, nr.dA4kMid, true))
                {
                    nr.die("Anime4K A+A restore launch failed");
                    return false;
                }
            }
            if (k + 1 < nr.a4kN)
                continue;
            // a one-pass chain's end after A+A: Clamp_Highlights on the 2x frame (the shader's PREKERNEL hook), then
            // the clip alone at an exact 2x target, else the Lanczos pair, which clips
            const bool exact = tw == 2 * w && th == h2;
            if (!nativeA4kClamp(nr, nr.dA4kMid, 2 * w, h2, st, exact))
            {
                nr.die("Anime4K A+A clamp launch failed");
                return false;
            }
            if (exact)
            {
                if (cudaMemcpyAsync(dst, nr.dA4kMid, (size_t)3 * tw * th * sizeof(float), cudaMemcpyDeviceToDevice,
                                    st) != cudaSuccess)
                {
                    nr.die("Anime4K A+A copy failed");
                    return false;
                }
                break;
            }
            const void* tabH = rsTabFor(nr, 2 * w, tw, st);
            const void* tabV = rsTabFor(nr, h2, th, st);
            if (!tabH || !tabV)
            {
                nr.die("Anime4K fold tap tables failed");
                return false;
            }
            // unclipped taps across (k_fitAaH; k_restFoldH would clip each), the one clip in the vertical pass, as
            // Mode A's last fold does
            int w2 = 2 * w;
            void* ah[] = {(void*)&src, &half, &ps, &rs, &w2, &h2, &nr.dA4kTmp, &tw, (void*)&tabH};
            void* av[] = {&nr.dA4kTmp, &tw, &h2, &dst, &th, (void*)&tabV};
            if (cuLaunchKernel(nr.fFitAaH, (tw + 15) / 16, (h2 + 15) / 16, 1, 16, 16, 1, 0, (CUstream)st, ah,
                               nullptr) != CUDA_SUCCESS ||
                cuLaunchKernel(nr.fRestFoldV, (tw + 15) / 16, (th + 15) / 16, 1, 16, 16, 1, 0, (CUstream)st, av,
                               nullptr) != CUDA_SUCCESS)
            {
                nr.die("Anime4K A+A fit launch failed");
                return false;
            }
            break;
        }
        if (tw == 2 * w && th == h2)
        {
            // an exact 2x target: the Lanczos pair is the identity there, one pass writes the clamped 2x values
            void* a2[] = {&nr.dA4kOut, &one, &nr.dA4kIn, &w, &h, &dst, &stat, &nr.a4kStatW, &nr.a4kStatH, &one};
            if (cuLaunchKernel(nr.fA4kFold2x, (tw + 15) / 16, (th + 15) / 16, 1, 16, 16, 1, 0, (CUstream)st, a2,
                               nullptr) != CUDA_SUCCESS)
            {
                nr.die("Anime4K fold (2x) launch failed");
                return false;
            }
            break;
        }
        const void* tabH = rsTabFor(nr, 2 * w, tw, st);
        const void* tabV = rsTabFor(nr, h2, th, st);
        if (!tabH || !tabV)
        {
            nr.die("Anime4K fold tap tables failed");
            return false;
        }
        void* ahs[] = {&nr.dA4kOut, &one,         &nr.dA4kIn, &w,           &h,          &nr.dA4kTmp,
                       &tw,         (void*)&tabH, &stat,      &nr.a4kStatW, &nr.a4kStatH};
        if (cuLaunchKernel(nr.fA4kFoldHSub, (tw + 15) / 16, (h2 + 15) / 16, 1, 16, 16, 1, 0, (CUstream)st, ahs,
                           nullptr) != CUDA_SUCCESS)
        {
            nr.die("Anime4K fold (horizontal) launch failed");
            return false;
        }
        void* av[] = {&nr.dA4kTmp, &tw, &h2, &dst, &th, (void*)&tabV};
        if (cuLaunchKernel(nr.fRestFoldV, (tw + 15) / 16, (th + 15) / 16, 1, 16, 16, 1, 0, (CUstream)st, av, nullptr) !=
            CUDA_SUCCESS)
        {
            nr.die("Anime4K fold (vertical) launch failed");
            return false;
        }
    }
    nr.a4kStatFresh = false;
    return true;
}

// every Anime4K buffer of the session: the resize's, Restore's and the statistics
static void nativeA4kRelease(NativeRife& nr)
{
    if (nr.stream && (nr.dA4kT || nr.dA4kRT))
        cudaStreamSynchronize(nr.stream);
    nativeA4kUpFree(nr);
    for (void** p :
         {&nr.dA4kRT, (void**)&nr.dA4kRMid, (void**)&nr.dA4kRTmp, (void**)&nr.dA4kStat, (void**)&nr.dA4kStatTmp})
        if (*p)
        {
            cudaFree(*p);
            *p = nullptr;
        }
    nr.a4kRTmpW = 0;
    nr.a4kStatCap = 0;
    nr.a4kStatW = nr.a4kStatH = 0;
    nr.a4kStatFresh = false;
}
