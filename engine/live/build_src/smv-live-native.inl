        "    float v00, v01, v02, v10, v11, v12, v20, v21, v22;\n";
    for (int k = 0; k < 16; k++)
    {
        sprintf_s(ln, "    a[%d] = ", k);
        s += ln;
        a4kLit(s, w[B2 + k]);
        s += ";\n";
    }
    for (int c = 0; c < 16; c++)
