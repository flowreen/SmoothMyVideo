    int* dGsOff[2] = {};
    int* dGsList[2] = {};
    float* dGsSrc[2] = {};
    int* dGsBlk[2] = {};
    bool gmGather = false;
    bool gmTail = false;    // the cut fusionnet (out = the pre-shuffle tensor): k_fuTail does shuffle + conv_last
