                  const float* __restrict__ t0, const float* __restrict__ t1, const float* __restrict__ t2,            \
                  unsigned short* __restrict__ out)                                                                    \
    {                                                                                                                  \
        giInBody<K>(x, ts, W, H, t0, t1, t2, out);                                                                     \
    }
