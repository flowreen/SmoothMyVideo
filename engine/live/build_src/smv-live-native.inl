static_assert(sizeof(kBbKern) / sizeof(kBbKern[0]) == sizeof(NativeRife::fBb) / sizeof(CUfunction),
              "one fBb slot a backbone kernel");
enum
{
    kBbC7,
    kBbStats,
    kBbFin,
    kBbRes0,
    kBbRes1,
    kBbRes2,
    kBbC64,
    kBbC64N,
